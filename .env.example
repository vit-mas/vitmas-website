# Cloudinary Gallery2 – add these in Vercel Dashboard > Settings > Environment Variables
# Get them from https://console.cloudinary.com/settings/api-keys
# IMPORTANT: CLOUDINARY_FOLDER must match exactly what you see in Media Library > Folders (case-sensitive)
# You created "VITMASGallery" under Home, so set it to VITMASGallery

CLOUDINARY_CLOUD_NAME=VITMASGallery
CLOUDINARY_API_KEY=VITMASGallery
CLOUDINARY_API_SECRET=VITMASGallery
CLOUDINARY_FOLDER=VITMASGallery

# Optional client hint (not secret) for UI label only - keep in sync with above
VITE_CLOUDINARY_FOLDER=VITMASGallery

