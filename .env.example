# Cloudinary Gallery2 – add these in Vercel Dashboard > Settings > Environment Variables
# Get them from https://console.cloudinary.com/settings/api-keys

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=VITMASGallery

# Optional client hint (not secret) for UI label only
VITE_CLOUDINARY_FOLDER=vitmas/gallery
